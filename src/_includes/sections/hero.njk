<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1 class="hero-heading">
        <img src="/assets/images/logo.png" alt="{{ t.heroHeading }}" class="hero-logo" width="280" height="320">
      </h1>
      <p class="hero-subtitle">{{ t.heroSubtitle }}</p>
      <p class="hero-body">{{ t.heroText }}</p>
      <p class="hero-body">{{ t.heroText2 }}</p>
      <p class="hero-credit">{{ t.credit }}</p>
    </div>
    <div class="hero-duck">
      <img src="/assets/images/pato.png" alt="{{ t.duckAlt }}" class="duck-img" width="320" height="637">
    </div>
  </div>
</section>
