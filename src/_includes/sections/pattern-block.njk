<section class="book-photos">
  <div class="container book-photos-inner">
    <h2 class="book-photos-heading">{{ t.bookPhotosHeading }}</h2>
    <div class="book-photos-grid">
      <figure class="book-photo">
        <img src="/assets/images/book-cover.jpg" alt="{{ t.bookCoverAlt }}" width="1000" height="750" loading="lazy">
      </figure>
      <figure class="book-photo">
        <img src="/assets/images/book-interior.jpg" alt="{{ t.bookInteriorAlt }}" width="1000" height="750" loading="lazy">
      </figure>
    </div>
  </div>
</section>
